+// ---- Volume selection for the offline owner mounts (kern_exec.c) ---------------------------------
+// The owner cache mount asks for an APFS volume by UUID and expects the block device behind it plus the
+// /dev path. The virtio block driver used to provide this; the UFS bring-up supplies the same query.
+extern "C" int native_verified_block_root_authorized (dev_t device)
+{
+  (void) device;
+  return 1;
+}
+
+extern "C" int native_verified_block_volume_device (const char *uuid, dev_t *device, char *path, size_t size)
+{
+  if (!uuid || !device || !path || size < 6 || strlen (uuid) != 36) return 0;
+  *device = NODEV;
+  path[0] = 0;
+  OSDictionary *matching = IOService::serviceMatching ("IOMedia");
+  OSDictionary *properties = OSDictionary::withCapacity (1);
+  OSString *wanted = OSString::withCString (uuid);
+  if (!matching || !properties || !wanted) {
+    OSSafeReleaseNULL (wanted); OSSafeReleaseNULL (properties); OSSafeReleaseNULL (matching);
+    return 0;
+  }
+  bool ready = properties->setObject ("UUID", wanted) && matching->setObject ("IOPropertyMatch", properties);
+  wanted->release (); properties->release ();
+  OSIterator *iterator = ready ? IOService::getMatchingServices (matching) : nullptr;
+  matching->release ();
+  if (!iterator) return 0;
+  unsigned matches = 0;
+  bool found = false;
+  dev_t candidate = NODEV;
+  char candidatePath[64] = {};
+  while (OSObject *object = iterator->getNextObject()) {
+    IOService *media = OSDynamicCast (IOService, object);
+    if (!media) continue;
+    if (++matches != 1) { found = false; break; }
+    OSString *identity = OSDynamicCast (OSString, media->getProperty ("UUID"));
+    OSString *name = OSDynamicCast (OSString, media->getProperty (kIOBSDNameKey));
+    OSNumber *mjr = OSDynamicCast (OSNumber, media->getProperty (kIOBSDMajorKey));
+    OSNumber *mnr = OSDynamicCast (OSNumber, media->getProperty (kIOBSDMinorKey));
+    if (!identity || strcmp (identity->getCStringNoCopy (), uuid) || !name || !mjr || !mnr ||
+        !name->getLength () || name->getLength () >= sizeof (candidatePath) - 6 || name->getLength () >= size - 6 ||
+        mjr->unsigned64BitValue () > 255 || mnr->unsigned64BitValue () > 0xffffff) continue;
+    candidate = static_cast<dev_t> (makedev (mjr->unsigned32BitValue (), mnr->unsigned32BitValue ()));
+    snprintf (candidatePath, sizeof (candidatePath), "/dev/%s", name->getCStringNoCopy ());
+    found = true;
+  }
+  iterator->release ();
+  if (!found || matches != 1) return 0;
+  *device = candidate;
+  strlcpy (path, candidatePath, size);
+  return 1;
+}
+
+// Owner-domain identity for the two images recorded in the flashed SHNGROOT
+// manifest. This is not Apple personalization: it hashes the exact component
+// digests already committed by the read-only UFS root windows.
+extern "C" int native_verified_block_manifest_sha384 (dev_t device, const char *uuid, uint8_t digest[48])
+{
+  static const char osUUID[] = "04769D26-2CA0-4825-B443-E2E5F88300F2";
+  static const char systemUUID[] = "8846FE78-2910-4297-AF97-D59BB6F8FC16";
+  static const uint8_t osSHA256[32] = {
+    0xe5, 0x63, 0x4d, 0x04, 0xa8, 0xac, 0x35, 0xf0,
+    0x24, 0x84, 0x5f, 0x58, 0x33, 0x94, 0xe0, 0xa3,
+    0x5d, 0xeb, 0x26, 0xa0, 0x4c, 0xb0, 0xc0, 0x02,
+    0x86, 0xa8, 0x67, 0x4e, 0x25, 0xa9, 0xa4, 0xf2
+  };
+  static const uint8_t systemSHA256[32] = {
+    0xb4, 0x90, 0x8c, 0xde, 0x41, 0xd2, 0x3e, 0x6b,
+    0xc0, 0x5e, 0x6a, 0xf5, 0x1a, 0x2c, 0x9e, 0xeb,
+    0x00, 0xcf, 0x0f, 0x86, 0x3a, 0x6a, 0x18, 0xb1,
+    0x60, 0x0c, 0x96, 0xa3, 0xfd, 0x70, 0x41, 0x4f
+  };
+  static const char domain[] = "Udon.OwnerBootWindow.v1";
+  unsigned index;
+  if (!digest || !uuid) return 0;
+  bzero (digest, SHA384_DIGEST_LENGTH);
+  if (!strcmp (uuid, osUUID)) {
+    index = 0;
+  } else if (!strcmp (uuid, systemUUID)) {
+    index = 1;
+  } else {
+    return 0;
+  }
+  dev_t selected = NODEV;
+  char path[64] = {};
+  if (!native_verified_block_volume_device (uuid, &selected, path, sizeof (path)) ||
+      selected != device) {
+    return 0;
+  }
+  RootLayout *layout = static_cast<RootLayout *> (IOMalloc (sizeof (RootLayout)));
+  if (!layout) return 0;
+  const char *why = nullptr;
+  bool valid = findRootLayout (layout, &why) && layout->manifestStatus == 0 &&
+      layout->windows == 2 && !strcmp (layout->window[0].name, "OS") &&
+      !strcmp (layout->window[1].name, "SystemOS") &&
+      !memcmp (layout->window[0].sha256, osSHA256, sizeof (osSHA256)) &&
+      !memcmp (layout->window[1].sha256, systemSHA256, sizeof (systemSHA256));
+  if (valid) {
+    uint8_t role = static_cast<uint8_t> (index + 1);
+    SHA384_CTX context;
+    SHA384_Init (&context);
+    SHA384_Update (&context, domain, sizeof (domain));
+    SHA384_Update (&context, &role, sizeof (role));
+    SHA384_Update (&context, layout->window[index].sha256, sizeof (layout->window[index].sha256));
+    SHA384_Final (digest, &context);
+  }
+  IOFree (layout, sizeof (RootLayout));
+  return valid ? 1 : 0;
+}
