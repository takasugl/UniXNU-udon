+/* udon bring-up: synchronous-exception probe for the pid 1 fault storm; the
+ * boot progress kit renders n/pc/far/esr, a 64-entry approximation of distinct
+ * faulted MiB regions, the hottest faulting PC, and the last eight (pc, far)
+ * pairs so a retry loop and forward progress look different on the HUD. */
+volatile uint64_t udon_sync_n, udon_sync_pc, udon_sync_far, udon_sync_esr;
+volatile uint32_t udon_sync_el0, udon_sync_distinct_mb;
+volatile uint64_t udon_sync_mb_top;
+volatile uint32_t udon_sync_mb_top_n;
+volatile uint64_t udon_sync_top_pc;
+volatile uint32_t udon_sync_top_pc_n;
+static uint64_t udon_sync_mb_keys[32];
+static uint32_t udon_sync_mb_hits[32];
+static uint64_t udon_sync_pc_keys[32];
+static uint32_t udon_sync_pc_hits[32];
+volatile uint64_t udon_sync_ring_pc[8], udon_sync_ring_far[8];
+volatile uint64_t udon_sync_lr;
+volatile uint64_t udon_vmfault_n, udon_vmfault_result, udon_vmfault_aborted, udon_vmfault_ok;
+static uint32_t udon_sync_ring_i;
+
 void
+udon_sync_probe(uint64_t pc, uint64_t lr, uint64_t far_addr, uint32_t esr, unsigned el0)
+{
+	udon_sync_n++;
+	udon_sync_pc = pc;
+	udon_sync_lr = lr;
+	udon_sync_far = far_addr;
+	udon_sync_esr = esr;
+	udon_sync_el0 = el0;
+	unsigned r = udon_sync_ring_i++ & 7;
+	udon_sync_ring_pc[r] = pc;
+	udon_sync_ring_far[r] = far_addr;
+	uint64_t mb = far_addr >> 20;
+	unsigned b = (unsigned)(mb & 31);
+	if (udon_sync_mb_keys[b] != mb) {
+		udon_sync_mb_keys[b] = mb;
+		udon_sync_mb_hits[b] = 0;
+		udon_sync_distinct_mb++;
+	}
+	if (++udon_sync_mb_hits[b] > udon_sync_mb_top_n) {
+		udon_sync_mb_top_n = udon_sync_mb_hits[b];
+		udon_sync_mb_top = mb;
+	}
+	unsigned q = (unsigned)((pc >> 2) & 31);
+	if (udon_sync_pc_keys[q] != pc) {
+		udon_sync_pc_keys[q] = pc;
+		udon_sync_pc_hits[q] = 0;
+	}
+	if (++udon_sync_pc_hits[q] > udon_sync_top_pc_n) {
+		udon_sync_top_pc_n = udon_sync_pc_hits[q];
+		udon_sync_top_pc = pc;
+	}
+}
